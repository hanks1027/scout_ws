<?xml version="1.0"?>
<robot name="mid360_demo" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find livox_mid360_gz_sim)/urdf/mid360_gz_plugin.xacro"/>
  <link name="base_footprint"/>
  <link name="base_link">
    <visual><geometry><box size="0.4 0.3 0.1"/></geometry></visual>
    <collision><geometry><box size="0.4 0.3 0.1"/></geometry></collision>
    <inertial><mass value="10"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
  </joint>
  <link name="mid360_link">
    <visual><geometry><cylinder radius="0.05" length="0.05"/></geometry></visual>
    <inertial><mass value="0.265"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0003"/></inertial>
  </link>
  <joint name="mid360_joint" type="fixed">
    <parent link="base_link"/><child link="mid360_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
  <gazebo reference="mid360_joint">
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>
  <link name="laser_link"/>
  <joint name="laser_alias_joint" type="fixed">
    <parent link="mid360_link"/><child link="laser_link"/>
  </joint>
  <xacro:livox_mid360_gz_plugin link_name="mid360_link" frame_id="laser_link"/>
</robot>
